DATABASE_URL=
TEST_DATABASE_URL=
SUPABASE_URL=
JWT_ISSUER=
JWT_AUDIENCE=
ALLOWED_ORIGINS=[]
# Only for explicit seed --bind-owners; actual Supabase subjects, never synthetic UUIDs.
DEMO_OWNER_A_SUB=
DEMO_OWNER_B_SUB=
# Short-lived access tokens for verification of the two subjects; never committed.
DEMO_OWNER_A_TOKEN=
DEMO_OWNER_B_TOKEN=
AI_API_KEY=
AI_MODEL=
# Server-only provider choice. Existing deployments remain Gemini by default.
AI_PROVIDER=gemini
OPENAI_API_KEY=
# Candidates verified in official docs; verify project access and RU/KZ quality before rollout.
OPENAI_MODEL=gpt-6-luna
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
AI_FALLBACK_OPENAI=false
AI_PRIMARY_TIMEOUT_SECONDS=8
# Server-only legacy Supabase service_role key; private bucket, no client Storage grants.
STORAGE_SERVICE_KEY=
STORAGE_BUCKET=
# Keep true for educational/demo environments; excluded from actual price statistics.
LIVESTOCK_DEMO_MODE=true
