# Full API prefix from docs/team5/02_ARCHITECTURE_API.md, e.g. https://api.example.test/api/v1
VITE_API_BASE_URL=
VITE_SUPABASE_URL=
# Only a PUBLIC publishable/anon key. Never a service_role or secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Keep false in production until the customer ids backend rollout is verified.
# Enable only for a backend candidate or isolated contract fixtures meanwhile.
VITE_CUSTOMER_IDS_ENABLED=false
