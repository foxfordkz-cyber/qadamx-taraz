# Full API prefix from docs/team5/02_ARCHITECTURE_API.md, e.g. https://api.example.test/api/v1
VITE_API_BASE_URL=
# Supabase Project URL, not a /rest/v1 or /auth/v1 service endpoint.
# Use the same approved project trusted by the configured Backend's JWT issuer.
VITE_SUPABASE_URL=
# Only a PUBLIC publishable/anon key. Never a service_role or secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Signup/resend always use https://qadamx-taraz.pages.dev/auth/callback.
# Vite pins this exact callback; hosting aliases and VITE_ overrides are ignored.
# Registration in a production bundle requires https://qadamx-taraz.pages.dev.
# Preserve existing Supabase Redirect URLs; add the exact callback before email QA.
# Cloudflare Pages: root apps/web, command npm run build:hosted, output dist.
# Local development defaults to legacy mode; set true with an ids-capable API.
# Hosting build-hosted.mjs pins true after the accepted Render PR61 rollout.
VITE_CUSTOMER_IDS_ENABLED=false
