# Full API prefix from docs/team5/02_ARCHITECTURE_API.md, e.g. https://api.example.test/api/v1
VITE_API_BASE_URL=
# Supabase Project URL, not a /rest/v1 or /auth/v1 service endpoint.
# Use the same approved project trusted by the configured Backend's JWT issuer.
VITE_SUPABASE_URL=
# Only a PUBLIC publishable/anon key. Never a service_role or secret key.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Signup/resend use the agreed fixed https://qadamx-taraz.vercel.app/auth/callback.
# Confirm the shared Supabase allowlist and real email flow before production rollout.
# A preview on another origin cannot reuse the production browser's PKCE verifier.
