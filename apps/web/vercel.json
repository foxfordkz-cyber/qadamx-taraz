{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "node scripts/check-deploy-env.mjs && npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!assets/|models/|previews/).*)",
      "destination": "/index.html"
    }
  ]
}
