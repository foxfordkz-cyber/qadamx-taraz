index c33eb9d3cbddc44e3c22390b32ae32c85cc24984..b4c6fec8d49680fb5f52ce55dbb5bc61fdd3af87 100644
--- a/apps/web/src/features/voice/audioContract.ts
+++ b/apps/web/src/features/voice/audioContract.ts
@@ -2,6 +2,7 @@
 // Server decoding remains authoritative for actual format and duration.
 export const MAX_AUDIO_BYTES = 8 * 1024 * 1024;
 export const MAX_AUDIO_MS = 30_000;
+export const MAX_AI_TEXT = 4000;
 export const AI_REQUEST_TIMEOUT_MS = 30_000; // Server AI deadline is 25 seconds.
 export const AUDIO_MIMES = new Set([
   "audio/wav",
@@ -22,3 +23,32 @@ export function validAudio(file: Blob) {
     AUDIO_MIMES.has(file.type.split(";", 1)[0].trim().toLowerCase())
   );
 }
+
+// Some file pickers omit MIME or report audio-only M4A as video/mp4.
+// This is a transport hint only; the shared backend still decodes actual bytes.
+export function normalizeAudioFile(file: File): File {
+  const type = file.type.split(";", 1)[0].trim().toLowerCase();
+  if (AUDIO_MIMES.has(type)) return file;
+  if (
+    type &&
+    !["application/octet-stream", "video/mp4", "audio/x-m4a"].includes(type)
+  )
+    return file;
+  const mime: Record<string, string> = {
+    wav: "audio/wav",
+    mp3: "audio/mpeg",
+    m4a: "audio/mp4",
+    mp4: "audio/mp4",
+    ogg: "audio/ogg",
+    opus: "audio/opus",
+    webm: "audio/webm",
+    flac: "audio/flac",
+  };
+  const inferred = mime[file.name.split(".").pop()?.toLowerCase() ?? ""];
+  return inferred
+    ? new File([file], file.name, {
+        type: inferred,
+        lastModified: file.lastModified,
+      })
+    : file;
+}
diff --git a/apps/web/src/features/voice/draftInput.ts b/apps/web/src/features/voice/draftInput.ts
new file mode 100644
index 0000000000000000000000000000000000000000..80b51f036974d9b0e5a4966da364f92deedcfbd8
--- /dev/null
+++ b/apps/web/src/features/voice/draftInput.ts
@@ -0,0 +1,11 @@
+import { MAX_AI_TEXT } from "./audioContract";
+
+export function validText(text: string) {
+  const length = Array.from(text.trim()).length;
+  return length > 0 && length <= MAX_AI_TEXT;
+}
+
+export function clarifiedText(transcript: string, correction: string) {
+  const text = `${transcript.trim()}\nНақтылау / Уточнение: ${correction.trim()}`;
+  return correction.trim() && validText(text) ? text : null;
+}
