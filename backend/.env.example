# Secrets stay on the server. Do not use a VITE_ prefix.
AI_API_KEY=
AI_MODEL=gemini-3.5-flash-lite
AI_FALLBACK_MODEL=gemini-3.8-flash
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Set true behind production HTTPS; localhost uses false.
COOKIE_SECURE=false
# SQLite database path, relative to backend/ unless absolute.
DATABASE_PATH=data/qadam.sqlite3
# Registration is enabled for local setup. Disable after creating accounts.
ALLOW_REGISTRATION=true
